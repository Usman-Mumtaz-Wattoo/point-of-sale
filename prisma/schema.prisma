generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

model Organization {
  id                   String                   @id @default(cuid())
  name                 String
  slug                 String                   @unique
  legalName            String?
  email                String?
  phone                String?
  address              String?
  city                 String?
  country              String?
  currency             String                   @default("USD")
  timezone             String                   @default("UTC")
  logoUrl              String?
  isActive             Boolean                  @default(true)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  branches             Branch[]
  categories           Category[]
  customers            Customer[]
  inventoryMovements   InventoryMovement[]
  inventoryStocks      InventoryStock[]
  memberships          OrganizationMembership[]
  settings             OrganizationSettings?
  products             Product[]
  variants             ProductVariant[]
  purchases            Purchase[]
  purchaseItems        PurchaseItem[]
  purchasePayments     PurchasePayment[]
  purchaseReceipts     PurchaseReceipt[]
  purchaseReceiptItems PurchaseReceiptItem[]
  purchaseReturns      PurchaseReturn[]
  purchaseReturnItems  PurchaseReturnItem[]
  sales                Sale[]
  saleItems            SaleItem[]
  salePayments         SalePayment[]
  saleReturns          SaleReturn[]
  saleReturnItems      SaleReturnItem[]
  saleRefunds          SaleRefund[]
  suppliers            Supplier[]
  invitations          OrganizationInvitation[]

  @@index([name])
  @@index([isActive])
}

model Branch {
  id                 String              @id @default(cuid())
  organizationId     String
  name               String
  code               String
  address            String?
  city               String?
  phone              String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id])
  memberships        BranchMembership[]
  settings           BranchSettings?
  inventoryMovements InventoryMovement[]
  inventoryStocks    InventoryStock[]
  purchases          Purchase[]
  purchaseReceipts   PurchaseReceipt[]
  purchaseReturns    PurchaseReturn[]
  sales              Sale[]
  saleReturns        SaleReturn[]
  primaryCustomers   Customer[]          @relation("BranchPrimaryCustomers")
  invitationBranches InvitationBranch[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
}

model OrganizationSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  currency       String       @default("USD")
  timezone       String       @default("UTC")
  dateFormat     String       @default("YYYY-MM-DD")
  invoicePrefix  String       @default("INV-")
  receiptPrefix  String       @default("REC-")
  taxEnabled     Boolean      @default(false)
  defaultTaxRate Decimal      @default(0.00) @db.Decimal(5, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model BranchSettings {
  id                   String   @id @default(cuid())
  branchId             String   @unique
  invoiceNumberPrefix  String?
  receiptNumberPrefix  String?
  defaultWarehouseName String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  branch               Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model User {
  id                       String                   @id @default(cuid())
  email                    String                   @unique
  name                     String
  avatarUrl                String?
  isActive                 Boolean                  @default(true)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  supabaseAuthId           String?                  @unique
  inventoryMovements       InventoryMovement[]
  memberships              OrganizationMembership[]
  createdPurchases         Purchase[]               @relation("CreatedPurchases")
  recordedPurchasePayments PurchasePayment[]        @relation("RecordedPurchasePayments")
  receivedPurchaseReceipts PurchaseReceipt[]        @relation("ReceivedPurchaseReceipts")
  returnedPurchaseReturns  PurchaseReturn[]         @relation("ReturnedPurchaseReturns")
  sales                    Sale[]                   @relation("CashierSales")
  recordedSalePayments     SalePayment[]            @relation("RecordedSalePayments")
  returnedSaleReturns      SaleReturn[]             @relation("ReturnedSaleReturns")
  processedSaleRefunds     SaleRefund[]             @relation("ProcessedSaleRefunds")
  sentInvitations          OrganizationInvitation[] @relation("SentInvitations")

  @@index([email])
  @@index([isActive])
}

model Role {
  id          String                   @id @default(cuid())
  name        String                   @unique
  description String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]
}

model OrganizationMembership {
  id                String             @id @default(cuid())
  userId            String
  organizationId    String
  roleId            String
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  branchMemberships BranchMembership[]
  organization      Organization       @relation(fields: [organizationId], references: [id])
  role              Role               @relation(fields: [roleId], references: [id])
  user              User               @relation(fields: [userId], references: [id])

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([roleId])
  @@index([organizationId, isActive])
}

model BranchMembership {
  id                       String                 @id @default(cuid())
  organizationMembershipId String
  branchId                 String
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  branch                   Branch                 @relation(fields: [branchId], references: [id])
  organizationMembership   OrganizationMembership @relation(fields: [organizationMembershipId], references: [id], onDelete: Cascade)

  @@unique([organizationMembershipId, branchId])
  @@index([organizationMembershipId])
  @@index([branchId])
}

model OrganizationInvitation {
  id             String             @id @default(cuid())
  organizationId String
  email          String
  roleId         String
  tokenHash      String             @unique
  status         InvitationStatus   @default(PENDING)
  expiresAt      DateTime
  invitedById    String?
  acceptedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role               @relation(fields: [roleId], references: [id])
  invitedBy      User?              @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  branches       InvitationBranch[]

  @@index([organizationId])
  @@index([email])
  @@index([tokenHash])
  @@index([organizationId, status])
}

model InvitationBranch {
  id           String                 @id @default(cuid())
  invitationId String
  branchId     String
  invitation   OrganizationInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  branch       Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([invitationId, branchId])
  @@index([invitationId])
  @@index([branchId])
}

model Category {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  products       Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isActive])
}

model Product {
  id                 String              @id @default(cuid())
  organizationId     String
  categoryId         String?
  name               String
  description        String?
  sku                String
  barcode            String?
  brand              String?
  imageUrl           String?
  unit               String              @default("piece")
  costPrice          Decimal             @default(0.00) @db.Decimal(12, 2)
  sellingPrice       Decimal             @default(0.00) @db.Decimal(12, 2)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryMovements InventoryMovement[]
  inventoryStocks    InventoryStock[]
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  organization       Organization        @relation(fields: [organizationId], references: [id])
  variants           ProductVariant[]
  purchaseItems      PurchaseItem[]
  saleItems          SaleItem[]
  saleReturnItems    SaleReturnItem[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([categoryId])
  @@index([name])
  @@index([barcode])
  @@index([isActive])
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  name               String
  sku                String?
  barcode            String?
  costPrice          Decimal?            @db.Decimal(12, 2)
  sellingPrice       Decimal?            @db.Decimal(12, 2)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organizationId     String
  inventoryMovements InventoryMovement[]
  inventoryStocks    InventoryStock[]
  organization       Organization        @relation(fields: [organizationId], references: [id])
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseItems      PurchaseItem[]
  saleItems          SaleItem[]
  saleReturnItems    SaleReturnItem[]

  @@unique([productId, name])
  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([productId])
  @@index([sku])
  @@index([barcode])
  @@index([isActive])
}

model InventoryStock {
  id              String          @id @default(cuid())
  organizationId  String
  branchId        String
  productId       String
  variantId       String?
  quantity        Decimal         @default(0.000) @db.Decimal(12, 3)
  reorderLevel    Decimal?        @db.Decimal(12, 3)
  reorderQuantity Decimal?        @db.Decimal(12, 3)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  branch          Branch          @relation(fields: [branchId], references: [id])
  organization    Organization    @relation(fields: [organizationId], references: [id])
  product         Product         @relation(fields: [productId], references: [id])
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([branchId, productId], map: "idx_inventory_stock_base_unique", where: raw("(\"variantId\" IS NULL)"))
  @@unique([branchId, variantId], map: "idx_inventory_stock_variant_unique", where: raw("(\"variantId\" IS NOT NULL)"))
  @@index([organizationId])
  @@index([branchId])
  @@index([productId])
  @@index([variantId])
  @@index([branchId, productId])
  @@index([branchId, variantId])
  @@index([branchId, quantity])
}

model InventoryMovement {
  id                String            @id @default(cuid())
  organizationId    String
  branchId          String
  productId         String
  variantId         String?
  movementType      StockMovementType
  quantityDelta     Decimal           @db.Decimal(12, 3)
  quantityBefore    Decimal           @db.Decimal(12, 3)
  quantityAfter     Decimal           @db.Decimal(12, 3)
  referenceType     String?
  referenceId       String?
  reason            String?
  notes             String?
  performedByUserId String?
  createdAt         DateTime          @default(now())
  branch            Branch            @relation(fields: [branchId], references: [id])
  organization      Organization      @relation(fields: [organizationId], references: [id])
  performedBy       User?             @relation(fields: [performedByUserId], references: [id])
  product           Product           @relation(fields: [productId], references: [id])
  variant           ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([branchId])
  @@index([productId, variantId])
  @@index([movementType])
  @@index([referenceType, referenceId])
  @@index([branchId, productId, createdAt])
  @@index([organizationId, createdAt])
  @@index([createdAt])
}

model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  city           String?
  taxNumber      String?
  paymentTerms   String?
  notes          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  purchases      Purchase[]
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([name])
}

model Purchase {
  id             String                @id @default(cuid())
  organizationId String
  branchId       String
  supplierId     String
  purchaseNumber String
  status         PurchaseStatus        @default(DRAFT)
  paymentStatus  PurchasePaymentStatus @default(UNPAID)
  orderDate      DateTime              @default(now())
  expectedDate   DateTime?
  subtotal       Decimal               @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal               @default(0.00) @db.Decimal(12, 2)
  taxAmount      Decimal               @default(0.00) @db.Decimal(12, 2)
  shippingAmount Decimal               @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal               @default(0.00) @db.Decimal(12, 2)
  paidAmount     Decimal               @default(0.00) @db.Decimal(12, 2)
  notes          String?
  createdById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  branch         Branch                @relation(fields: [branchId], references: [id])
  createdBy      User?                 @relation("CreatedPurchases", fields: [createdById], references: [id])
  organization   Organization          @relation(fields: [organizationId], references: [id])
  supplier       Supplier              @relation(fields: [supplierId], references: [id])
  items          PurchaseItem[]
  payments       PurchasePayment[]
  receipts       PurchaseReceipt[]
  returns        PurchaseReturn[]

  @@unique([organizationId, purchaseNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([supplierId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderDate])
}

model PurchaseItem {
  id               String                @id @default(cuid())
  organizationId   String
  purchaseId       String
  productId        String
  variantId        String?
  quantityOrdered  Decimal               @db.Decimal(12, 3)
  quantityReceived Decimal               @default(0.000) @db.Decimal(12, 3)
  quantityReturned Decimal               @default(0.000) @db.Decimal(12, 3)
  unitCost         Decimal               @db.Decimal(12, 2)
  taxRate          Decimal               @default(0.00) @db.Decimal(5, 2)
  lineTotal        Decimal               @db.Decimal(12, 2)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  organization     Organization          @relation(fields: [organizationId], references: [id])
  product          Product               @relation(fields: [productId], references: [id])
  purchase         Purchase              @relation(fields: [purchaseId], references: [id])
  variant          ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  receiptItems     PurchaseReceiptItem[]
  returnItems      PurchaseReturnItem[]

  @@index([organizationId])
  @@index([purchaseId])
  @@index([productId, variantId])
}

model PurchasePayment {
  id             String                @id @default(cuid())
  organizationId String
  purchaseId     String
  amount         Decimal               @db.Decimal(12, 2)
  paymentMethod  PurchasePaymentMethod
  paidAt         DateTime              @default(now())
  reference      String?
  notes          String?
  recordedById   String?
  createdAt      DateTime              @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id])
  purchase       Purchase              @relation(fields: [purchaseId], references: [id])
  recordedBy     User?                 @relation("RecordedPurchasePayments", fields: [recordedById], references: [id])

  @@index([organizationId])
  @@index([purchaseId])
  @@index([paidAt])
}

model PurchaseReceipt {
  id             String                @id @default(cuid())
  organizationId String
  purchaseId     String
  branchId       String
  receiptNumber  String
  receivedAt     DateTime              @default(now())
  receivedById   String?
  notes          String?
  createdAt      DateTime              @default(now())
  branch         Branch                @relation(fields: [branchId], references: [id])
  organization   Organization          @relation(fields: [organizationId], references: [id])
  purchase       Purchase              @relation(fields: [purchaseId], references: [id])
  receivedBy     User?                 @relation("ReceivedPurchaseReceipts", fields: [receivedById], references: [id])
  items          PurchaseReceiptItem[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([purchaseId])
  @@index([branchId])
  @@index([receivedAt])
}

model PurchaseReceiptItem {
  id               String          @id @default(cuid())
  organizationId   String
  receiptId        String
  purchaseItemId   String
  quantityReceived Decimal         @db.Decimal(12, 3)
  createdAt        DateTime        @default(now())
  organization     Organization    @relation(fields: [organizationId], references: [id])
  purchaseItem     PurchaseItem    @relation(fields: [purchaseItemId], references: [id])
  receipt          PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([receiptId])
  @@index([purchaseItemId])
}

model PurchaseReturn {
  id             String               @id @default(cuid())
  organizationId String
  purchaseId     String
  branchId       String
  returnNumber   String
  returnDate     DateTime             @default(now())
  returnedById   String?
  reason         String?
  notes          String?
  createdAt      DateTime             @default(now())
  branch         Branch               @relation(fields: [branchId], references: [id])
  organization   Organization         @relation(fields: [organizationId], references: [id])
  purchase       Purchase             @relation(fields: [purchaseId], references: [id])
  returnedBy     User?                @relation("ReturnedPurchaseReturns", fields: [returnedById], references: [id])
  items          PurchaseReturnItem[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId])
  @@index([purchaseId])
  @@index([branchId])
  @@index([returnDate])
}

model PurchaseReturnItem {
  id               String         @id @default(cuid())
  organizationId   String
  returnId         String
  purchaseItemId   String
  quantityReturned Decimal        @db.Decimal(12, 3)
  unitCost         Decimal        @db.Decimal(12, 2)
  lineTotal        Decimal        @db.Decimal(12, 2)
  reason           String?
  createdAt        DateTime       @default(now())
  organization     Organization   @relation(fields: [organizationId], references: [id])
  purchaseItem     PurchaseItem   @relation(fields: [purchaseItemId], references: [id])
  return           PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([returnId])
  @@index([purchaseItemId])
}

model Customer {
  id              String       @id @default(cuid())
  organizationId  String
  primaryBranchId String?
  code            String?
  name            String
  email           String?
  phone           String?
  address         String?
  city            String?
  taxNumber       String?
  notes           String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id])
  primaryBranch   Branch?      @relation("BranchPrimaryCustomers", fields: [primaryBranchId], references: [id], onDelete: SetNull)
  sales           Sale[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, name])
  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@index([primaryBranchId])
}

model Sale {
  id             String            @id @default(cuid())
  organizationId String
  branchId       String
  invoiceNumber  String
  receiptNumber  String?
  status         SaleStatus        @default(DRAFT)
  paymentStatus  SalePaymentStatus @default(UNPAID)
  saleDate       DateTime          @default(now())
  subtotal       Decimal           @default(0) @db.Decimal(12, 2)
  discountAmount Decimal           @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal           @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal           @default(0) @db.Decimal(12, 2)
  changeAmount   Decimal           @default(0) @db.Decimal(12, 2)
  notes          String?
  cashierId      String?
  customerId     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  branch         Branch            @relation(fields: [branchId], references: [id])
  cashier        User?             @relation("CashierSales", fields: [cashierId], references: [id])
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  organization   Organization      @relation(fields: [organizationId], references: [id])
  items          SaleItem[]
  payments       SalePayment[]
  returns        SaleReturn[]
  refunds        SaleRefund[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([status])
  @@index([paymentStatus])
  @@index([saleDate])
  @@index([cashierId])
  @@index([customerId])
}

// Row-level CHECK constraints enforced in PostgreSQL:
// - chk_sale_item_qty_returned: CHECK ("quantityReturned" >= 0)
// - chk_sale_item_qty_ret_le_sold: CHECK ("quantityReturned" <= quantity)
// - chk_sale_item_amount_returned: CHECK ("amountReturned" >= 0)
// - chk_sale_item_amount_ret_le_line_total: CHECK ("amountReturned" <= "lineTotal")
model SaleItem {
  id               String           @id @default(cuid())
  organizationId   String
  saleId           String
  productId        String
  variantId        String?
  productName      String
  productSku       String?
  quantity         Decimal          @db.Decimal(12, 3)
  unitPrice        Decimal          @db.Decimal(12, 2)
  unitCost         Decimal          @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal          @default(0) @db.Decimal(12, 2)
  taxRate          Decimal          @default(0) @db.Decimal(5, 2)
  taxAmount        Decimal          @default(0) @db.Decimal(12, 2)
  subtotal         Decimal          @db.Decimal(12, 2)
  lineTotal        Decimal          @db.Decimal(12, 2)
  quantityReturned Decimal          @default(0.000) @db.Decimal(12, 3)
  amountReturned   Decimal          @default(0.00) @db.Decimal(12, 2)
  createdAt        DateTime         @default(now())
  organization     Organization     @relation(fields: [organizationId], references: [id])
  product          Product          @relation(fields: [productId], references: [id])
  sale             Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant          ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  returnItems      SaleReturnItem[]

  @@index([organizationId])
  @@index([saleId])
  @@index([productId, variantId])
}

model SalePayment {
  id             String            @id @default(cuid())
  organizationId String
  saleId         String
  paymentMethod  SalePaymentMethod
  amount         Decimal           @db.Decimal(12, 2)
  tenderedAmount Decimal?          @db.Decimal(12, 2)
  changeAmount   Decimal?          @db.Decimal(12, 2)
  reference      String?
  notes          String?
  paidAt         DateTime          @default(now())
  recordedById   String?
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id])
  recordedBy     User?             @relation("RecordedSalePayments", fields: [recordedById], references: [id])
  sale           Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([saleId])
  @@index([paidAt])
  @@index([paymentMethod])
}

// Row-level CHECK constraints enforced in PostgreSQL:
// - chk_sale_return_subtotal: CHECK (subtotal >= 0)
// - chk_sale_return_discount_amount: CHECK ("discountAmount" >= 0)
// - chk_sale_return_tax_amount: CHECK ("taxAmount" >= 0)
// - chk_sale_return_total_amount: CHECK ("totalAmount" >= 0)
// - chk_sale_return_refunded_amount: CHECK ("refundedAmount" >= 0)
// - chk_sale_return_discount_le_subtotal: CHECK ("discountAmount" <= subtotal)
// - chk_sale_return_total_identity: CHECK ("totalAmount" = subtotal - "discountAmount" + "taxAmount")
// - chk_sale_return_refunded_equals_total: CHECK ("refundedAmount" = "totalAmount")
model SaleReturn {
  id              String           @id @default(cuid())
  organizationId  String
  saleId          String
  branchId        String
  returnNumber    String
  idempotencyKey  String?
  idempotencyHash String?
  returnDate      DateTime         @default(now())
  returnedById    String?
  subtotal        Decimal          @db.Decimal(12, 2)
  discountAmount  Decimal          @default(0.00) @db.Decimal(12, 2)
  taxAmount       Decimal          @default(0.00) @db.Decimal(12, 2)
  totalAmount     Decimal          @db.Decimal(12, 2)
  refundedAmount  Decimal          @default(0.00) @db.Decimal(12, 2)
  reason          String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  returnedBy      User?            @relation("ReturnedSaleReturns", fields: [returnedById], references: [id], onDelete: SetNull)
  sale            Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  items           SaleReturnItem[]
  refunds         SaleRefund[]

  @@unique([organizationId, returnNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([saleId])
  @@index([branchId])
  @@index([returnDate])
}

// Row-level CHECK constraints enforced in PostgreSQL:
// - chk_sale_return_item_qty_positive: CHECK ("quantityReturned" > 0)
// - chk_sale_return_item_unit_price: CHECK ("unitPrice" >= 0)
// - chk_sale_return_item_unit_cost: CHECK ("unitCost" >= 0)
// - chk_sale_return_item_discount_amount: CHECK ("discountAmount" >= 0)
// - chk_sale_return_item_tax_rate: CHECK ("taxRate" >= 0)
// - chk_sale_return_item_tax_amount: CHECK ("taxAmount" >= 0)
// - chk_sale_return_item_subtotal: CHECK (subtotal >= 0)
// - chk_sale_return_item_line_total: CHECK ("lineTotal" >= 0)
// - chk_sale_return_item_discount_le_subtotal: CHECK ("discountAmount" <= subtotal)
// - chk_sale_return_item_line_total_identity: CHECK ("lineTotal" = subtotal - "discountAmount" + "taxAmount")
model SaleReturnItem {
  id               String          @id @default(cuid())
  organizationId   String
  returnId         String
  saleItemId       String
  productId        String
  variantId        String?
  productName      String
  productSku       String?
  quantityReturned Decimal         @db.Decimal(12, 3)
  unitPrice        Decimal         @db.Decimal(12, 2)
  unitCost         Decimal         @db.Decimal(12, 2)
  discountAmount   Decimal         @default(0.00) @db.Decimal(12, 2)
  taxRate          Decimal         @default(0.00) @db.Decimal(5, 2)
  taxAmount        Decimal         @default(0.00) @db.Decimal(12, 2)
  subtotal         Decimal         @db.Decimal(12, 2)
  lineTotal        Decimal         @db.Decimal(12, 2)
  reason           String?
  createdAt        DateTime        @default(now())
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  return           SaleReturn      @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem         SaleItem        @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([returnId])
  @@index([saleItemId])
  @@index([productId, variantId])
}

// Row-level CHECK constraints enforced in PostgreSQL:
// - chk_sale_refund_amount: CHECK (amount > 0)
model SaleRefund {
  id             String            @id @default(cuid())
  organizationId String
  saleId         String
  returnId       String?
  refundNumber   String
  paymentMethod  SalePaymentMethod
  amount         Decimal           @db.Decimal(12, 2)
  reference      String?
  notes          String?
  refundedAt     DateTime          @default(now())
  processedById  String?
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  processedBy    User?             @relation("ProcessedSaleRefunds", fields: [processedById], references: [id], onDelete: SetNull)
  return         SaleReturn?       @relation(fields: [returnId], references: [id], onDelete: SetNull)
  sale           Sale              @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, refundNumber])
  @@index([organizationId])
  @@index([saleId])
  @@index([returnId])
  @@index([refundedAt])
  @@index([paymentMethod])
}

