generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  legalName String?
  email     String?
  phone     String?
  address   String?
  city      String?
  country   String?
  currency  String   @default("USD")
  timezone  String   @default("UTC")
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches             Branch[]
  categories           Category[]
  products             Product[]
  variants             ProductVariant[]
  inventoryStocks      InventoryStock[]
  inventoryMovements   InventoryMovement[]
  memberships          OrganizationMembership[]
  settings             OrganizationSettings?
  suppliers            Supplier[]
  purchases            Purchase[]
  purchaseItems        PurchaseItem[]
  purchasePayments     PurchasePayment[]
  purchaseReceipts     PurchaseReceipt[]
  purchaseReceiptItems PurchaseReceiptItem[]
  purchaseReturns      PurchaseReturn[]
  purchaseReturnItems  PurchaseReturnItem[]

  @@index([name])
  @@index([isActive])
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  address        String?
  city           String?
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships        BranchMembership[]
  settings           BranchSettings?
  inventoryStocks    InventoryStock[]
  inventoryMovements InventoryMovement[]
  purchases          Purchase[]
  purchaseReceipts   PurchaseReceipt[]
  purchaseReturns    PurchaseReturn[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
}

model OrganizationSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  currency       String   @default("USD")
  timezone       String   @default("UTC")
  dateFormat     String   @default("YYYY-MM-DD")
  invoicePrefix  String   @default("INV-")
  receiptPrefix  String   @default("REC-")
  taxEnabled     Boolean  @default(false)
  defaultTaxRate Decimal  @default(0.00) @db.Decimal(5, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model BranchSettings {
  id                   String   @id @default(cuid())
  branchId             String   @unique
  invoiceNumberPrefix  String?
  receiptNumberPrefix  String?
  defaultWarehouseName String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model User {
  id             String   @id @default(cuid())
  supabaseAuthId String?  @unique
  email          String   @unique
  name           String
  avatarUrl      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships              OrganizationMembership[]
  inventoryMovements       InventoryMovement[]
  createdPurchases         Purchase[]               @relation("CreatedPurchases")
  recordedPurchasePayments PurchasePayment[]        @relation("RecordedPurchasePayments")
  receivedPurchaseReceipts PurchaseReceipt[]        @relation("ReceivedPurchaseReceipts")
  returnedPurchaseReturns  PurchaseReturn[]         @relation("ReturnedPurchaseReturns")

  @@index([email])
  @@index([isActive])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships OrganizationMembership[]
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  roleId         String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role              Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branchMemberships BranchMembership[]

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([roleId])
  @@index([organizationId, isActive])
}

model BranchMembership {
  id                       String   @id @default(cuid())
  organizationMembershipId String
  branchId                 String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organizationMembership OrganizationMembership @relation(fields: [organizationMembershipId], references: [id], onDelete: Cascade)
  branch                 Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([organizationMembershipId, branchId])
  @@index([organizationMembershipId])
  @@index([branchId])
}

model Category {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isActive])
}

model Product {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String?
  name           String
  description    String?
  sku            String
  barcode        String?
  brand          String?
  unit           String   @default("piece")
  costPrice      Decimal  @default(0.00) @db.Decimal(12, 2)
  sellingPrice   Decimal  @default(0.00) @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants           ProductVariant[]
  inventoryStocks    InventoryStock[]
  inventoryMovements InventoryMovement[]
  purchaseItems      PurchaseItem[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([categoryId])
  @@index([name])
  @@index([barcode])
  @@index([isActive])
}

model ProductVariant {
  id             String   @id @default(cuid())
  organizationId String
  productId      String
  name           String
  sku            String?
  barcode        String?
  costPrice      Decimal? @db.Decimal(12, 2)
  sellingPrice   Decimal? @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryStocks    InventoryStock[]
  inventoryMovements InventoryMovement[]
  purchaseItems      PurchaseItem[]

  @@unique([productId, name])
  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([productId])
  @@index([sku])
  @@index([barcode])
  @@index([isActive])
}

enum StockMovementType {
  OPENING_BALANCE
  PURCHASE_RECEIPT
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE
  WASTE
  TRANSFER_IN
  TRANSFER_OUT
}

model InventoryStock {
  id             String  @id @default(cuid())
  organizationId String
  branchId       String
  productId      String
  variantId      String?

  quantity Decimal @default(0.000) @db.Decimal(12, 3)

  reorderLevel    Decimal? @db.Decimal(12, 3)
  reorderQuantity Decimal? @db.Decimal(12, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([branchId])
  @@index([productId])
  @@index([variantId])
  @@index([branchId, productId])
  @@index([branchId, variantId])
  @@index([branchId, quantity])
}

model InventoryMovement {
  id             String  @id @default(cuid())
  organizationId String
  branchId       String
  productId      String
  variantId      String?

  movementType StockMovementType

  quantityDelta  Decimal @db.Decimal(12, 3)
  quantityBefore Decimal @db.Decimal(12, 3)
  quantityAfter  Decimal @db.Decimal(12, 3)

  referenceType String?
  referenceId   String?

  reason String?
  notes  String?

  performedByUserId String?

  createdAt DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  performedBy  User?           @relation(fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([branchId])
  @@index([productId, variantId])
  @@index([movementType])
  @@index([referenceType, referenceId])
  @@index([branchId, productId, createdAt])
  @@index([organizationId, createdAt])
  @@index([createdAt])
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchasePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PurchasePaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  OTHER
}

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  city           String?
  taxNumber      String?
  paymentTerms   String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchases    Purchase[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([name])
}

model Purchase {
  id             String                @id @default(cuid())
  organizationId String
  branchId       String
  supplierId     String
  purchaseNumber String
  status         PurchaseStatus        @default(DRAFT)
  paymentStatus  PurchasePaymentStatus @default(UNPAID)
  orderDate      DateTime              @default(now())
  expectedDate   DateTime?
  subtotal       Decimal               @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal               @default(0.00) @db.Decimal(12, 2)
  taxAmount      Decimal               @default(0.00) @db.Decimal(12, 2)
  shippingAmount Decimal               @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal               @default(0.00) @db.Decimal(12, 2)
  paidAmount     Decimal               @default(0.00) @db.Decimal(12, 2)
  notes          String?
  createdById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier     Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy    User?             @relation("CreatedPurchases", fields: [createdById], references: [id], onDelete: SetNull)
  items        PurchaseItem[]
  payments     PurchasePayment[]
  receipts     PurchaseReceipt[]
  returns      PurchaseReturn[]

  @@unique([organizationId, purchaseNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([supplierId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderDate])
}

model PurchaseItem {
  id               String   @id @default(cuid())
  organizationId   String
  purchaseId       String
  productId        String
  variantId        String?
  quantityOrdered  Decimal  @db.Decimal(12, 3)
  quantityReceived Decimal  @default(0.000) @db.Decimal(12, 3)
  quantityReturned Decimal  @default(0.000) @db.Decimal(12, 3)
  unitCost         Decimal  @db.Decimal(12, 2)
  taxRate          Decimal  @default(0.00) @db.Decimal(5, 2)
  lineTotal        Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchase     Purchase              @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  product      Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant      ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  receiptItems PurchaseReceiptItem[]
  returnItems  PurchaseReturnItem[]

  @@index([organizationId])
  @@index([purchaseId])
  @@index([productId, variantId])
}

model PurchasePayment {
  id             String                @id @default(cuid())
  organizationId String
  purchaseId     String
  amount         Decimal               @db.Decimal(12, 2)
  paymentMethod  PurchasePaymentMethod
  paidAt         DateTime              @default(now())
  reference      String?
  notes          String?
  recordedById   String?
  createdAt      DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchase     Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  recordedBy   User?        @relation("RecordedPurchasePayments", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([purchaseId])
  @@index([paidAt])
}

model PurchaseReceipt {
  id             String   @id @default(cuid())
  organizationId String
  purchaseId     String
  branchId       String
  receiptNumber  String
  receivedAt     DateTime @default(now())
  receivedById   String?
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchase     Purchase              @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  branch       Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  receivedBy   User?                 @relation("ReceivedPurchaseReceipts", fields: [receivedById], references: [id], onDelete: SetNull)
  items        PurchaseReceiptItem[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([purchaseId])
  @@index([branchId])
  @@index([receivedAt])
}

model PurchaseReceiptItem {
  id               String   @id @default(cuid())
  organizationId   String
  receiptId        String
  purchaseItemId   String
  quantityReceived Decimal  @db.Decimal(12, 3)
  createdAt        DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receipt      PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseItem PurchaseItem    @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([receiptId])
  @@index([purchaseItemId])
}

model PurchaseReturn {
  id             String   @id @default(cuid())
  organizationId String
  purchaseId     String
  branchId       String
  returnNumber   String
  returnDate     DateTime @default(now())
  returnedById   String?
  reason         String?
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchase     Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  returnedBy   User?                @relation("ReturnedPurchaseReturns", fields: [returnedById], references: [id], onDelete: SetNull)
  items        PurchaseReturnItem[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId])
  @@index([purchaseId])
  @@index([branchId])
  @@index([returnDate])
}

model PurchaseReturnItem {
  id               String   @id @default(cuid())
  organizationId   String
  returnId         String
  purchaseItemId   String
  quantityReturned Decimal  @db.Decimal(12, 3)
  unitCost         Decimal  @db.Decimal(12, 2)
  lineTotal        Decimal  @db.Decimal(12, 2)
  reason           String?
  createdAt        DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  return       PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  purchaseItem PurchaseItem   @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([returnId])
  @@index([purchaseItemId])
}
